# ==========================================
# LAURREL BACKEND API — ENVIRONMENT CONFIGURATION
# ==========================================

# Server Configuration
NODE_ENV=production
PORT=5000
FRONTEND_ORIGIN=https://laurrelservices.ca
PUBLIC_SITE_URL=https://laurrelservices.ca

# Security & Admin Access
ADMIN_API_SECRET=your_secure_admin_api_secret_here
ADMIN_OWNER_EMAIL=owner@laurrelservices.ca
ADMIN_OWNER_PASSWORD=your_secure_initial_owner_password

# Dedicated Secret for At-Rest AES-256-GCM Encryption (Mandatory on backend)
ENCRYPTION_SECRET=your_secure_32_byte_hex_encryption_secret_here

# PostgreSQL Database (Neon PostgreSQL)
# Format: postgresql://username:password@hostname:5432/database_name?sslmode=require
DATABASE_URL=

# Isolated Neon Testing Database Branch (Required for write-based test suites)
# Never point this to production! Write suites refuse to execute if this matches DATABASE_URL
TEST_DATABASE_URL=

# Google Workspace Calendar & Meet OAuth2 Integration
GOOGLE_CALENDAR_CLIENT_ID=
GOOGLE_CALENDAR_CLIENT_SECRET=
GOOGLE_CALENDAR_REDIRECT_URI=https://laurrelservices.ca/admin/appointments/settings
GOOGLE_AUTHORIZED_ACCOUNT=dispatch@laurrelservices.ca

# AI Assistant Configuration
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Email Notification Provider (Option 1: Resend - Preferred)
EMAIL_PROVIDER=resend
RESEND_API_KEY=
EMAIL_FROM="Laurrel Dispatch <dispatch@laurrelservices.ca>"
ENQUIRY_TO_EMAIL=info@laurrelservices.ca

# Email Notification Provider (Option 2: Shared-Hosting SMTP)
# EMAIL_PROVIDER=smtp
# SMTP_HOST=mail.laurrelservices.ca
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=dispatch@laurrelservices.ca
# SMTP_PASSWORD=your_smtp_password
