# ========================================================
# LAURREL SERVICES — GLOBAL ENVIRONMENT CONFIGURATION
# ========================================================

# --------------------------------------------------------
# A. NETLIFY FRONTEND CONFIGURATION
# Set these in the Netlify Site Settings -> Environment Variables
# --------------------------------------------------------

# 1. Sanity CMS Settings
# Obtain from https://www.sanity.io/manage
NEXT_PUBLIC_SANITY_PROJECT_ID=
NEXT_PUBLIC_SANITY_DATASET=production
NEXT_PUBLIC_SANITY_API_VERSION=2024-01-01
SANITY_API_READ_TOKEN=

# 2. Render Backend API Forwarding
# URL of your deployed Render Web Service (e.g. https://api.laurrelservices.ca or https://laurrel-api.onrender.com)
# Leave empty during local development to use local handlers.
BACKEND_API_URL=

# 3. Operations Administration & Session Security
# Master backend authentication secret (shared between Netlify and Render)
ADMIN_API_SECRET=
# HMAC signing secret for browser HttpOnly session cookies (32+ character random string)
ADMIN_SESSION_SECRET=
# Primary Owner Account (used for initial portal access)
ADMIN_OWNER_EMAIL=owner@laurrelservices.ca
ADMIN_OWNER_PASSWORD=

# 4. Google Maps Platform Embed Configuration (Optional)
# If blank, the website uses the built-in accessible Ottawa boundary map
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=

# --------------------------------------------------------
# B. RENDER BACKEND CONFIGURATION
# Set these in Render Dashboard -> Web Service -> Environment
# --------------------------------------------------------

# Server Runtime
NODE_ENV=production
PORT=5000
FRONTEND_ORIGIN=https://laurrelservices.ca

# PostgreSQL Database (Render Managed PostgreSQL)
# Format: postgresql://username:password@hostname:5432/database_name?sslmode=require
DATABASE_URL=

# Google Gemini AI Assistant
# Obtain key at https://aistudio.google.com/
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Transactional Email Notification (Option 1: Resend - Preferred)
# Obtain API key and verify domain at https://resend.com
EMAIL_PROVIDER=resend
RESEND_API_KEY=
EMAIL_FROM="Laurrel Dispatch <dispatch@laurrelservices.ca>"
ENQUIRY_TO_EMAIL=info@laurrelservices.ca

# Transactional Email Notification (Option 2: Shared-Hosting SMTP)
# EMAIL_PROVIDER=smtp
# SMTP_HOST=mail.laurrelservices.ca
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=dispatch@laurrelservices.ca
# SMTP_PASSWORD=

# Billing & Payment Provider (Staging / Future Live Gate)
# Live billing remains withheld until business account authorization
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
ENABLE_LIVE_BILLING=false
