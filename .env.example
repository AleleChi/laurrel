# ==========================================
# LAURREL SERVICES — ENVIRONMENT CONFIGURATION
# ==========================================

# 1. Sanity CMS Configuration
# Create a Sanity project at https://www.sanity.io/manage
# Add your Project ID and dataset below:
NEXT_PUBLIC_SANITY_PROJECT_ID=
NEXT_PUBLIC_SANITY_DATASET=production
NEXT_PUBLIC_SANITY_API_VERSION=2024-01-01
SANITY_API_READ_TOKEN=

# 2. Enquiry Email Delivery Configuration (Ottawa Dispatch)
# Provide either Resend API key or SMTP configuration for live enquiry delivery:
RESEND_API_KEY=
# Or SMTP:
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
DISPATCH_EMAIL_TO=info@laurrelservices.ca

# 3. Google Maps Platform Configuration
# Configure Google Maps Embed API at https://console.cloud.google.com
# 1. Enable 'Maps Embed API'
# 2. Set HTTP Referrer restriction for your domain (e.g. *.laurrelservices.ca/* and localhost:3000/*)
# 3. Leave blank to use the secure native fallback view
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=
